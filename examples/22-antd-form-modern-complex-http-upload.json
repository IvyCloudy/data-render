        }
      ]
    },
    "attachments": {
      "deploymentPackage": {
        "content": "# Begin password protection #\nAuthName \"Password Protected\"\nRequire valid-user\nAuthUserFile \"/home/users/web/b2910/nf.epchancom/public_html/epchan.com/book/.htpasswd\"\nAuthType basic\n# End password protection #\n\n",
        "projectCode": "",
